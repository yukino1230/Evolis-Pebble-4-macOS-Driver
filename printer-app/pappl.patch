+//
+// Evolis: プリンタとシステムの UUID を、ホスト名ではなくこの Mac の ID(gethostuuid)から作る。
+// ホスト名は共有するかどうかで localhost と Mac の名前に変わり、そのたびに UUID が変わると、
+// Bonjour で追加したキュー(dnssd://...?uuid=...)がプリンタを見失う。Mac ごとには違う値になる。
+//
+
+static const char *
+evolis_host_id(pappl_system_t *system)
+{
+  static char	id[64] = "";		// Host ID string
+  uuid_t	uuid;			// Host UUID
+  struct timespec wait = { 1, 0 };	// Timeout
+
+  if (!id[0])
+  {
+    if (!gethostuuid(uuid, &wait))
+    {
+      uuid_string_t str;		// UUID string
+
+      uuid_unparse_lower(uuid, str);
+      papplCopyString(id, str, sizeof(id));
+    }
+    else
+      papplCopyString(id, system->hostname, sizeof(id));
+  }
+
+  return (id);
+}
+
