#!/bin/bash
# Evolis Pebble 4 を IPP Everywhere のプリンタとして見せる(Printer Application の試作)。
# PPD のドライバが使えなくなったとき用。macOS の ippeveprinter に、属性(evolis-pebble4.conf)と
# 印刷コマンド(evolis-ipp-print)を渡して動かす。
#
#   ipp/evolis-ipp-server [--ribbon k] [--option Key=Value]... [--port 8631] [--name 名前]
#                         [--output DIR] [--no-dnssd]
#
#   --ribbon     付いているリボン(PPD の EvolisRibbon と同じ値。既定は k)
#   --option     そのほかのオプション(EvolisOverlay=chipiso など、PPD と同じキー)
#   --output     USB に送らずに、印刷データを DIR にファイルで書く(試すとき)
#   --no-dnssd   ネットワークに広告しない(試すとき)
#
# DNS-SD で広告するので、「設定」>「プリンタとスキャナ」の追加に出てくる。止めるときは Ctrl-C。
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
RIBBON=k; OPTS=""; PORT=8631; NAME="Evolis Pebble 4"; OUTPUT=""; DNSSD=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ribbon) RIBBON="$2"; shift 2 ;;
    --option) OPTS="$OPTS $2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --no-dnssd) DNSSD=(-r off); shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
# 変換(rastertoevolis)と USB への送信(evolis-usb-send)は、このリポジトリから build/ipp に作って使う
ROOT="$HERE/.."; BIN="$ROOT/build/ipp"
mkdir -p "$BIN"
if [ ! -x "$BIN/rastertoevolis" ] || [ "$ROOT/driver/evolis_card.c" -nt "$BIN/rastertoevolis" ] \
   || [ "$ROOT/driver/rastertoevolis.c" -nt "$BIN/rastertoevolis" ]; then
  clang -O2 -Wall -o "$BIN/rastertoevolis" "$ROOT/driver/rastertoevolis.c" "$ROOT/driver/evolis_card.c"
fi
if [ ! -x "$BIN/evolis-usb-send" ] || [ "$ROOT/driver/evolis-usb-send.swift" -nt "$BIN/evolis-usb-send" ] \
   || [ "$ROOT/app/Sources/EvolisUSB.swift" -nt "$BIN/evolis-usb-send" ]; then
  swiftc -swift-version 5 -parse-as-library -O -o "$BIN/evolis-usb-send" \
         "$ROOT/app/Sources/EvolisUSB.swift" "$ROOT/driver/evolis-usb-send.swift"
fi
export EVOLIS_CONVERT="${EVOLIS_CONVERT:-$BIN/rastertoevolis}" EVOLIS_SEND="${EVOLIS_SEND:-$BIN/evolis-usb-send}"
export EVOLIS_OPTIONS="EvolisRibbon=$RIBBON$OPTS"
SPOOL="${TMPDIR:-/tmp}/evolis-ipp-spool"
mkdir -p "$SPOOL"
ARGS=(-a "$HERE/evolis-pebble4.conf" -c "$HERE/evolis-ipp-print" -d "$SPOOL" -p "$PORT" ${DNSSD[@]+"${DNSSD[@]}"})
[ -n "$OUTPUT" ] && ARGS+=(-D "$OUTPUT")
echo "Evolis Pebble 4 (IPP): ipp://localhost:$PORT/ipp/print  options: $EVOLIS_OPTIONS" >&2
exec ippeveprinter -v "${ARGS[@]}" "$NAME"
